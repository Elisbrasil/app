# Pagina inicial
DirectoryIndex index.html

# Tipo correto para imagens WebP
AddType image/webp .webp

# Compressao (o HTML chega bem menor)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript image/svg+xml
</IfModule>

# Cache: imagens ficam guardadas no navegador por 30 dias; o HTML e sempre conferido
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Forcar HTTPS: tire o "#" das 3 linhas abaixo DEPOIS que o SSL do dominio estiver ativo no cPanel
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
